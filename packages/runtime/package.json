{
  "name": "@typespex/runtime",
  "version": "0.1.1",
  "description": "Framework-agnostic HTTP server runtime for TypeSpec-generated services",
  "license": "MIT",
  "author": "spilne",
  "homepage": "https://github.com/spilne/typespex",
  "bugs": { "url": "https://github.com/spilne/typespex/issues" },
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/runtime"
  },
  "keywords": ["typespec", "server", "http", "runtime", "typescript", "codegen"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "src", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "lossless-json": "^4.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
