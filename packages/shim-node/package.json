{
  "name": "@typespex/shim-node",
  "version": "0.1.1",
  "description": "Node.js http adapter for @typespex/runtime HTTP router",
  "license": "MIT",
  "author": "spilne",
  "homepage": "https://github.com/spilne/typespex",
  "bugs": { "url": "https://github.com/spilne/typespex/issues" },
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/shim-node"
  },
  "keywords": ["typespec", "node", "server", "http", "adapter"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "src", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typespex/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0"
  }
}
