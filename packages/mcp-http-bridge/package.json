{
  "name": "@typespex/mcp-http-bridge",
  "version": "0.1.1",
  "description": "HTTP operation bridge for TypeSpex-generated MCP tools",
  "keywords": [
    "bridge",
    "http",
    "mcp",
    "model-context-protocol",
    "typespec"
  ],
  "homepage": "https://github.com/spilne/typespex",
  "bugs": {
    "url": "https://github.com/spilne/typespex/issues"
  },
  "license": "MIT",
  "author": "spilne",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/mcp-http-bridge"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@typespex/codec": "workspace:*",
    "@typespex/http-client": "workspace:*",
    "@typespex/mcp-server": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
