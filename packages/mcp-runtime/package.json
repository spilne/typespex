{
  "name": "@typespex/mcp-runtime",
  "version": "0.1.1",
  "description": "Runtime support for TypeSpex-generated Model Context Protocol servers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "runtime",
    "typescript",
    "typespec"
  ],
  "homepage": "https://github.com/spilne/typespex",
  "bugs": {
    "url": "https://github.com/spilne/typespex/issues"
  },
  "license": "MIT",
  "author": "spilne",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/mcp-runtime"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "default": "./dist/stdio.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./http-bridge": {
      "types": "./dist/http-bridge.d.ts",
      "default": "./dist/http-bridge.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@typespex/runtime": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "22.12.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/node": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
