{
  "name": "@typespex/http-server",
  "version": "0.1.1",
  "description": "Framework-agnostic HTTP server for TypeSpec-generated services",
  "keywords": [
    "http",
    "server",
    "typescript",
    "typespec"
  ],
  "homepage": "https://github.com/spilne/typespex",
  "bugs": {
    "url": "https://github.com/spilne/typespex/issues"
  },
  "license": "MIT",
  "author": "spilne",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/http-server"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@typespex/codec": "workspace:*",
    "lossless-json": "^4.3.1",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
