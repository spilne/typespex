{
  "name": "@typespex/mcp",
  "version": "0.1.1",
  "description": "TypeSpec vocabulary for strongly typed Model Context Protocol servers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "typespec"
  ],
  "homepage": "https://github.com/spilne/typespex",
  "bugs": {
    "url": "https://github.com/spilne/typespex/issues"
  },
  "license": "MIT",
  "author": "spilne",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.15.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@typespec/compiler": ">=1.14.0 <2.0.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "tspMain": "lib/main.tsp"
}
