{
  "name": "@typespex/compiler-core",
  "version": "0.1.1",
  "description": "Unstable protocol-neutral compiler planning utilities for TypeSpex emitters",
  "keywords": [
    "compiler",
    "typescript",
    "typespec"
  ],
  "homepage": "https://github.com/spilne/typespex",
  "bugs": {
    "url": "https://github.com/spilne/typespex/issues"
  },
  "license": "MIT",
  "author": "spilne",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/compiler-core"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./unstable": {
      "types": "./dist/unstable.d.ts",
      "default": "./dist/unstable.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "test:defaults": "bun test --timeout 30000 test/defaults.test.ts"
  },
  "dependencies": {
    "@typespex/codec": "workspace:*",
    "oxfmt": "0.63.0"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.15.0",
    "@typespec/http": "^1.15.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@typespec/compiler": ">=1.14.0 <2.0.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
