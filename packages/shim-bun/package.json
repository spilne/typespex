{
  "name": "@typespex/shim-bun",
  "version": "0.1.0",
  "description": "Bun adapter for @typespex/runtime HTTP router",
  "license": "MIT",
  "author": "spilne",
  "homepage": "https://github.com/spilne/typespex",
  "bugs": { "url": "https://github.com/spilne/typespex/issues" },
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/shim-bun"
  },
  "keywords": ["typespec", "bun", "server", "http", "adapter"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typespex/runtime": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
