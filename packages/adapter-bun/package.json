{
  "name": "@typespex/adapter-bun",
  "version": "0.1.1",
  "description": "Bun adapter for @typespex/http-server HTTP router",
  "keywords": [
    "adapter",
    "bun",
    "http",
    "server",
    "typespec"
  ],
  "homepage": "https://github.com/spilne/typespex",
  "bugs": {
    "url": "https://github.com/spilne/typespex/issues"
  },
  "license": "MIT",
  "author": "spilne",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/adapter-bun"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typespex/http-server": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
