"// AUTO-GENERATED by @typespex/emitter — do not edit

import type { Decoder, ServerOperation } from "@typespex/runtime/server";
import {
  Either,
  createHints,
  emptyHints,
  ResponseEncoders,
  Decoders,
  RequestDecoders,
  Validators,
  decodeRequestInput,
  decodeRequestInputAndBody,
  decodeRequestInputAndMultipartBody,
  decodeJsonBody,
  decodeFormBody,
  decodeMultipartBody,
} from "@typespex/runtime/server";
import * as ServerHints from "./server-hints.js";
import type { ConflictError, ForbiddenError, Item, NotFoundError } from "./models.js";

const ItemsInput = {
  read: RequestDecoders.path("itemId", Decoders.string).map((itemId) => ({ itemId })),
  remove: RequestDecoders.path("itemId", Decoders.string).map((itemId) => ({ itemId })),
  updateRequest: RequestDecoders.path("itemId", Decoders.string).map((itemId) => ({ itemId })),
  updateBody: Decoders.object<Item>({
    id: Decoders.string,
    name: Decoders.string,
  }),
};

const ItemsOutput = {
  read: ResponseEncoders.oneOf<Item | { _: 404; code: "NOT_FOUND"; message: string }>([
    {
      kind: "property",
      cases: {
        id: { status: 200, contentType: "application/json" },
        code: { status: 404, contentType: "application/json", omit: ["_"] },
      },
    },
  ]),
  remove: ResponseEncoders.oneOf<
    | void
    | { _: 404; code: "NOT_FOUND"; message: string }
    | { _: 403; code: "FORBIDDEN"; message: string }
  >([
    { kind: "undefined", variant: { status: 204, kind: "empty" } },
    {
      kind: "field",
      field: "_",
      cases: {
        "404": { status: 404, contentType: "application/json", omit: ["_"] },
        "403": { status: 403, contentType: "application/json", omit: ["_"] },
      },
    },
  ]),
  update: ResponseEncoders.oneOf<
    | Item
    | { _: 404; code: "NOT_FOUND"; message: string }
    | { _: 409; conflictId: string; message: string }
  >([
    {
      kind: "property",
      cases: {
        id: { status: 200, contentType: "application/json" },
        code: { status: 404, contentType: "application/json", omit: ["_"] },
        conflictId: { status: 409, contentType: "application/json", omit: ["_"] },
      },
    },
  ]),
};

export const ItemsOperations = {
  read: {
    endpoint: {
      service: { name: "MultiErrorApi", hints: emptyHints() },
      namespaces: [],
      operation: {
        name: "read",
        operationId: "Items.read",
        method: "GET" as const,
        path: "/items/:itemId",
        hints: emptyHints(),
      },
    },
    decodeInput: (request, pathParams) =>
      decodeRequestInput<{ itemId: string }>(ItemsInput.read, request, pathParams),
    encodeResult: (result: Item | { _: 404; code: "NOT_FOUND"; message: string }) =>
      ItemsOutput.read.encode(result),
  } satisfies ServerOperation<
    { itemId: string },
    Item | { _: 404; code: "NOT_FOUND"; message: string }
  >,

  remove: {
    endpoint: {
      service: { name: "MultiErrorApi", hints: emptyHints() },
      namespaces: [],
      operation: {
        name: "remove",
        operationId: "Items.remove",
        method: "DELETE" as const,
        path: "/items/:itemId",
        hints: emptyHints(),
      },
    },
    decodeInput: (request, pathParams) =>
      decodeRequestInput<{ itemId: string }>(ItemsInput.remove, request, pathParams),
    encodeResult: (
      result:
        | void
        | { _: 404; code: "NOT_FOUND"; message: string }
        | { _: 403; code: "FORBIDDEN"; message: string },
    ) => ItemsOutput.remove.encode(result),
  } satisfies ServerOperation<
    { itemId: string },
    | void
    | { _: 404; code: "NOT_FOUND"; message: string }
    | { _: 403; code: "FORBIDDEN"; message: string }
  >,

  update: {
    endpoint: {
      service: { name: "MultiErrorApi", hints: emptyHints() },
      namespaces: [],
      operation: {
        name: "update",
        operationId: "Items.update",
        method: "PUT" as const,
        path: "/items/:itemId",
        hints: emptyHints(),
      },
    },
    decodeInput: async (request, pathParams) =>
      decodeRequestInputAndBody<{ itemId: string }, Item>(
        ItemsInput.updateRequest,
        ItemsInput.updateBody,
        request,
        pathParams,
      ),
    encodeResult: (
      result:
        | Item
        | { _: 404; code: "NOT_FOUND"; message: string }
        | { _: 409; conflictId: string; message: string },
    ) => ItemsOutput.update.encode(result),
  } satisfies ServerOperation<
    { itemId: string; id: string; name: string },
    | Item
    | { _: 404; code: "NOT_FOUND"; message: string }
    | { _: 409; conflictId: string; message: string }
  >,
} as const;
"
`;

