      },
    },
    decodeInput: () => Either.right({} as Record<string, never>),
    encodeResult: (result: { contentType: "text/plain"; body: string }) =>
      TextOutput.plain.encode(result),
  } satisfies ServerOperation<Record<string, never>, { contentType: "text/plain"; body: string }>,
} as const;

const BinaryOutput = {
  download: ResponseEncoders.variant<{ contentType: "application/octet-stream"; body: Uint8Array }>(
    {
