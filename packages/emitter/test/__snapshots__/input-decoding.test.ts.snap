import type { CreateItem } from "./models.js";

const ItemsInput = {
  list: RequestDecoders.combine(
    [
      RequestDecoders.query(
        "limit",
        Decoders.number.validate(Validators.minValue(1), Validators.maxValue(100)),
      ),
      RequestDecoders.query(
        "ratio",
        Decoders.number.validate(Validators.minValueExclusive(0), Validators.maxValueExclusive(1)),
      ),
    ],
    (limit, ratio) => ({ limit, ratio }),
  ),
  read: RequestDecoders.path("itemId", Decoders.bigint.validate(Validators.minValue(1n))).map(
