  ),
  create: Decoders.object<CreateItem>({
    name: Decoders.string.validate(
      Validators.minLength(1),
      Validators.maxLength(20),
      Validators.pattern("^[A-Z].*", "Must start with uppercase."),
    ),
    tags: Decoders.strictArray(Decoders.string).validate(
      Validators.minItems(1),
      Validators.maxItems(3),
    ),
    count: Decoders.number.validate(Validators.minValue(0)),
  }),
};

const ItemsOutput = {
