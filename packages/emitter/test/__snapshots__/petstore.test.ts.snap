  decodeRequestInputAndBody,
  decodeRequestInputAndMultipartBody,
  decodeJsonBody,
  decodeFormBody,
  decodeMultipartBody,
} from "@typespex/runtime/server";
import * as ServerHints from "./server-hints.js";
import type { CreatePetInput, NotFoundError, Pet } from "./models.js";

const PetsInput = {
  list: RequestDecoders.combine(
    [
      RequestDecoders.query(
        "limit",
        Decoders.number.validate(Validators.minValue(1), Validators.maxValue(100)).optional(),
      ),
      RequestDecoders.query("offset", Decoders.number.validate(Validators.minValue(0)).optional()),
    ],
    (limit, offset) => ({ limit, offset }),
  ),
  create: Decoders.object<CreatePetInput>({
    name: Decoders.string.validate(
      Validators.minLength(1),
      Validators.maxLength(80),
      Validators.pattern("^[A-Za-z].*", "Must start with a letter."),
    ),
    tag: Decoders.optional(Decoders.string.validate(Validators.maxLength(40))),
  }),
  read: RequestDecoders.path("petId", Decoders.string.validate(Validators.minLength(1))).map(
    (petId) => ({ petId }),
  ),
  delete: RequestDecoders.path("petId", Decoders.string.validate(Validators.minLength(1))).map(
    (petId) => ({ petId }),
  ),
};

const PetsOutput = {
  list: ResponseEncoders.json<Pet[]>(200),
  create: ResponseEncoders.json<Pet>(200),
  read: ResponseEncoders.json<Pet>(200),
  delete: ResponseEncoders.empty(204),
};

const PetsErrors = {
  list: ErrorEncoders.json<never>(500),
  create: ErrorEncoders.json<never>(500),
  read: ErrorEncoders.json<NotFoundError>(404),
  delete: ErrorEncoders.json<NotFoundError>(404),
};

export const PetsOperations = {
  list: {
    endpoint: {
      service: { name: "PetStore", hints: emptyHints() },
      namespaces: [],
      operation: {
        name: "list",
        operationId: "Pets.list",
        method: "GET" as const,
        path: "/pets",
        hints: emptyHints(),
      },
    },
    decodeInput: (request, pathParams) =>
      decodeRequestInput<{ limit?: number; offset?: number }>(PetsInput.list, request, pathParams),
    encodeOutput: (output: Pet[]) => PetsOutput.list.encode(output),
    encodeError: (error: never) => PetsErrors.list.encode(error),
  } satisfies ServerOperation<{ limit?: number; offset?: number }, never, Pet[]>,

  create: {
    endpoint: {
      service: { name: "PetStore", hints: emptyHints() },
      namespaces: [],
      operation: {
        name: "create",
        operationId: "Pets.create",
        method: "POST" as const,
        path: "/pets",
        hints: emptyHints(),
      },
    },
    decodeInput: async (request) => decodeJsonBody<CreatePetInput>(request, PetsInput.create),
    encodeOutput: (output: Pet) => PetsOutput.create.encode(output),
    encodeError: (error: never) => PetsErrors.create.encode(error),
  } satisfies ServerOperation<CreatePetInput, never, Pet>,

  read: {
    endpoint: {
      service: { name: "PetStore", hints: emptyHints() },
      namespaces: [],
      operation: {
        name: "read",
        operationId: "Pets.read",
        method: "GET" as const,
        path: "/pets/:petId",
        hints: emptyHints(),
      },
    },
    decodeInput: (request, pathParams) =>
      decodeRequestInput<{ petId: string }>(PetsInput.read, request, pathParams),
    encodeOutput: (output: Pet) => PetsOutput.read.encode(output),
    encodeError: (error: NotFoundError) => PetsErrors.read.encode(error),
  } satisfies ServerOperation<{ petId: string }, NotFoundError, Pet>,

  delete: {
    endpoint: {
      service: { name: "PetStore", hints: emptyHints() },
      namespaces: [],
      operation: {
        name: "delete",
        operationId: "Pets.delete",
