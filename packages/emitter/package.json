{
  "name": "@typespex/emitter",
  "version": "0.1.1",
  "description": "TypeSpec emitter that generates TypeScript HTTP server bindings",
  "keywords": [
    "codegen",
    "emitter",
    "http",
    "server",
    "typescript",
    "typespec"
  ],
  "homepage": "https://github.com/spilne/typespex",
  "bugs": {
    "url": "https://github.com/spilne/typespex/issues"
  },
  "license": "MIT",
  "author": "spilne",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/emitter"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@typespex/runtime": "workspace:*",
    "oxfmt": "0.62.0"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.15.0",
    "@typespec/http": "^1.15.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@typespec/compiler": ">=1.0.0 <2.0.0",
    "@typespec/http": ">=1.0.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@js-temporal/polyfill": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
