{
  "name": "@typespex/emitter",
  "version": "0.1.1",
  "description": "TypeSpec emitter that generates TypeScript HTTP server bindings",
  "license": "MIT",
  "author": "spilne",
  "homepage": "https://github.com/spilne/typespex",
  "bugs": { "url": "https://github.com/spilne/typespex/issues" },
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/typespex.git",
    "directory": "packages/emitter"
  },
  "keywords": ["typespec", "emitter", "codegen", "server", "http", "typescript"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist", "src", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@typespec/compiler": ">=1.0.0 <2.0.0",
    "@typespec/http": ">=1.0.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@js-temporal/polyfill": { "optional": true }
  },
  "dependencies": {
    "@typespex/runtime": "workspace:*",
    "oxfmt": "^0.50.0"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.14.0",
    "@typespec/http": "^1.14.0",
    "typescript": "^5.7.0"
  }
}
