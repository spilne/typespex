{
  "name": "typespex",
  "private": true,
  "workspaces": [
    "packages/*",
    "example",
    "bench"
  ],
  "scripts": {
    "audit:dependencies": "bun audit --audit-level=moderate --ignore=GHSA-w5hq-g745-h8pq",
    "build": "bun run --filter '*' build",
    "clean": "bun run --filter '*' clean",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:release",
    "typecheck:release": "bun packages/shim-node/node_modules/typescript/bin/tsc --project scripts/tsconfig.json",
    "test": "bun test --timeout 30000",
    "generate:example": "./scripts/generate-example.sh",
    "check:generated": "bun run --filter @typespex/emitter build && ./scripts/check-generated-example.sh",
    "check:conformance": "bun run --filter @typespex/runtime build && bun run --filter @typespex/emitter build && bun scripts/check-http-conformance.mjs",
    "check:packages": "bun ./scripts/release-packages.ts --package-check",
    "release:preflight": "./scripts/publish-packages.sh",
    "publish:packages": "./scripts/publish-packages.sh --publish"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "oxfmt": "0.62.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "tar": "7.5.22"
  },
  "packageManager": "bun@1.3.14"
}
