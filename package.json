{
  "name": "typespex",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": ["packages/*", "example", "bench"],
  "scripts": {
    "audit:dependencies": "bun audit --audit-level=moderate --ignore=GHSA-w5hq-g745-h8pq",
    "build": "bun run --filter '*' build",
    "clean": "bun run --filter '*' clean",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "generate:example": "./scripts/generate-example.sh",
    "check:generated": "bun run --filter @typespex/emitter build && ./scripts/check-generated-example.sh",
    "publish:packages": "./scripts/publish-packages.sh"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "tar": "7.5.22"
  },
  "devDependencies": {}
}
